# Copy to .env and fill in. Never commit .env.
# Generate secrets:   docker compose run --rm web new-secret
# Password hash:      docker compose run --rm web hash-password
# (Keep comments on their own lines; values containing $ must stay in single quotes.)

# Public HTTPS origin; Buffer/Meta fetch finished clips from here
CLIPPER_PUBLIC_BASE_URL=https://clips.example.com
# Hostname Caddy obtains the certificate for
CLIPPER_DOMAIN=clips.example.com
# Set to false only for plain-http local testing
COOKIE_SECURE=true

SESSION_SECRET=
OWNER_PASSWORD_HASH=
BACKUP_KEY=
# Optional off-host copy of backups (requires rclone)
# BACKUP_RCLONE_REMOTE=b2:my-bucket/greatclipper

ANTHROPIC_API_KEY=

BUFFER_API_KEY=
# Enables reconciliation lookups of recent posts after an ambiguous send
BUFFER_ORGANIZATION_ID=
# BUFFER_API_URL=https://api.buffer.com

# Long-lived token + user id of the Instagram professional account
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Set to the current Graph API version
INSTAGRAM_GRAPH_VERSION=v23.0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
